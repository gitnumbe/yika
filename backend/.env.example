# ===== yika 生产级环境配置模板 =====
# 复制为 .env 后填写；.env 不入 git

# 大模型（OpenAI 兼容，实例以开发文档 §4.0 基线表为准）
LLM_BASE_URL=http://<大模型地址>/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash-vision-exp

# 去噪小模型（Ollama）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# STT（Qwen3-ASR-1.7B 本地服务·决策 09）
ASR_BASE_URL=http://127.0.0.1:8051
# TTS（dots.tts-mf 本地服务·决策 09）
TTS_BASE_URL=http://127.0.0.1:8052
# TTS 参考音（管理员预录：wav 路径 + 对应文本）
TTS_REF_AUDIO=
TTS_REF_TEXT=

# 数据库（dev=sqlite / prod=postgresql）
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://yika:pass@postgres:5432/yika

# 安全
SECRET_KEY=change-me-to-random-32chars
# CORS 白名单（逗号分隔，生产必配）
CORS_ORIGINS=http://localhost:5173,http://<内网域名或IP>

# 语音服务模型目录（deploy 容器挂载）
ASR_MODEL_DIR=/models/qwen3-asr-1.7b
TTS_MODEL_DIR=/models/dots-tts-mf
